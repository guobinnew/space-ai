{
  "name": "smart-space-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:full": "npm --prefix ../server run build && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "npm --prefix ../server run build && concurrently --kill-others -n server,tauri -c blue,green \"npm --prefix ../server run start\" \"tauri dev\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
