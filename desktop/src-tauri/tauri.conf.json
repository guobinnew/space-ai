{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2-schema/main/tauri.conf.json",
  "productName": "Smart Space",
  "version": "0.1.0",
  "identifier": "com.smartspace.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:full"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart Space",
        "width": 1000,
        "height": 680,
        "minWidth": 1280,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splash",
        "title": "Smart Space",
        "width": 400,
        "height": 300,
        "center": true,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "url": "splashscreen.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../server/dist/agent/": "agent/"
    }
  }
}
